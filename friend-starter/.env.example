# Browser-safe values only
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side / Edge Function secrets — never expose in browser code
ANTHROPIC_API_KEY=YOUR_OWN_KEY
# Optional alternative provider if the implementation supports it
OPENAI_API_KEY=YOUR_OWN_KEY

# Only if a server-side migration/admin script genuinely needs it.
# Never prefix this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_OWN_SERVICE_ROLE_KEY